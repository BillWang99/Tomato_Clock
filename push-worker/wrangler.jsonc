// 蕃茄鐘的推播小伺服器：記住「幾毫秒後提醒誰」，時間到發 Web Push。
// 部署：npx wrangler deploy（需要先 npx wrangler login）
// 秘密：VAPID_PRIVATE_KEY 只存在 Cloudflare；要換新請在專案根目錄執行 npm run vapid:rotate
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tomato-push",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // 不留請求日誌，伺服器端不保存任何呼叫紀錄
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "ALERTS", "class_name": "AlertObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AlertObject"] }],
  // 同一個 IP 每分鐘最多 30 次排程／取消
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    // 總開關：被灌請求或要暫停推播時改成 "false"，再 npx wrangler deploy
    "PUSH_ENABLED": "true",
    "ALLOWED_ORIGINS": "https://billwang99.github.io,http://localhost:5173,http://localhost:5174,http://localhost:4173",
    "VAPID_SUBJECT": "https://github.com/BillWang99/Tomato_Clock",
    // 公鑰可以公開；由 npm run vapid:rotate 自動更新，網站的 src/core/pushConfig.ts 是同一把
    "VAPID_PUBLIC_KEY": "BCmcGkN8OWZJ7GNXbM982uIiP7YDwGVhpOIXtkxrZzgXNZ7BGw1Rn_5N50MbEMe_U2UAi-ER1COd9loqng3PtlE"
  }
}
